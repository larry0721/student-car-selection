# Dependencies and package-manager caches
node_modules/
.pnpm-store/

# Next.js build outputs
.next/
out/
.vercel/
tsconfig.tsbuildinfo

# Local environment and secrets
.env
.env.local
.env.*.local
.env*.local
!.env.example

# Kaggle/source downloads are large and can be regenerated.
data/raw/**
!data/raw/
!data/raw/KAGGLE_DATASET_REVIEW.md

# Local catalog-enrichment review manifests may contain retained source snapshots.
data/enrichment-review/manifests/**
!data/enrichment-review/manifests/
!data/enrichment-review/manifests/.gitkeep

# Local vehicle-knowledge repositories retain approved source-derived claims.
data/vehicle-knowledge/repositories/**
!data/vehicle-knowledge/repositories/
!data/vehicle-knowledge/repositories/.gitkeep

# Shadow published CVR repositories are versioned locally and may contain source-derived intelligence.
data/published-vehicle-intelligence/repositories/**
!data/published-vehicle-intelligence/repositories/
!data/published-vehicle-intelligence/repositories/.gitkeep

# Python and OS artifacts
__pycache__/
*.py[cod]
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Legacy static prototype kept locally only
/app.js
/index.html
/styles.css
.vercel/
.env*
!.env.example
