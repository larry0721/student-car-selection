NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=
SEMANTIC_UNDERSTANDING_PROVIDER=auto
OPENAI_SEMANTIC_UNDERSTANDING_MODEL=
SEMANTIC_UNDERSTANDING_TIMEOUT_MS=12000
SEMANTIC_UNDERSTANDING_MAX_RETRIES=1

# Public government sources require no keys:
# - NHTSA vPIC
# - FuelEconomy.gov

# Used-car marketplace/listing data requires a provider account.
# Option A: Marketcheck
USED_CAR_API_PROVIDER=marketcheck
MARKETCHECK_API_KEY=
MARKETCHECK_BASE_URL=https://api.marketcheck.com/v2/search/car/active

# Option B: custom listing API compatible with this app's normalized adapter
USED_CAR_API_BASE_URL=
USED_CAR_API_KEY=
